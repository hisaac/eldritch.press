#set page(paper: sys.inputs.at("paper", default: "a5"), margin: 17mm, numbering: "1")
#set text(lang: $lang-literal$, size: 11pt)
#set par(justify: true, first-line-indent: 1.5em)
#set document(title: [$title$], author: $author-literal$, date: none)
#align(center)[
	#text(size: 17pt, weight: "bold")[$title$] \
	by #text($author-literal$)
]

$body$
